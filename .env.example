# Copy this file to `.env.local` (for `next dev`) and/or `.dev.vars` (for the
# Cloudflare Workers preview). In production, set these in the Cloudflare
# dashboard: Workers & Pages → your project → Settings → Variables & Secrets.
# NEVER commit real values — .env.local and .dev.vars are gitignored.

# --- Visitor counter (Upstash Redis, optional) ---
# Without these the counter shows 0 (Cloudflare's filesystem is read-only).
# Create a database at https://console.upstash.com/ and use its REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Note: the hero "favorite song" card uses Apple Music and needs NO secrets.
# Configure the song in src/config/music.ts.
